<%- include('partials/header', { title: 'Matrículas', actual: 'matriculas' }) %>

<main class="container py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/index.html">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Matrículas</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="mb-0" id="titulo-matriculas">
            <%= (usuario && usuario.rol === 'admin') ? 'Gestión global de matrículas' : 'Mis matrículas' %>
        </h2>
        <div class="d-flex" role="search">
            <label for="busqueda-matriculas" class="visually-hidden">Buscar matrículas</label>
            <input type="search" id="busqueda-matriculas" class="form-control" placeholder="Filtrar matrículas...">
        </div>
    </div>

    <div id="alerta-matriculas" class="d-none" role="alert" aria-live="polite"></div>

    <!-- Formulario de nueva matrícula (solo alumnos) -->
    <section id="seccion-nueva-matricula"
        class="card mb-4 <%= (!usuario || usuario.rol !== 'alumno') ? 'd-none' : '' %>"
        aria-labelledby="titulo-nueva-matricula">
        <div class="card-body">
            <h3 id="titulo-nueva-matricula" class="h4 mb-3">Matricularme en un curso</h3>
            <form id="form-nueva-matricula" class="row g-3 align-items-end" novalidate>
                <div class="col-md-8">
                    <label for="select-curso-matricula" class="form-label">Selecciona un curso disponible *</label>
                    <select id="select-curso-matricula" class="form-select" required>
                        <option value="">Cargando cursos disponibles...</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn border-success w-100 fw-semibold">
                        <i class="bi bi-journal-check me-2"></i>Confirmar matrícula
                    </button>
                </div>
            </form>
            <div id="resumen-curso-seleccionado" class="mt-3 text-muted small"></div>
        </div>
    </section>

    <!-- Listado de matrículas -->
    <section aria-labelledby="titulo-listado-matriculas">
        <h3 id="titulo-listado-matriculas" class="h5 mb-3">Listado de inscripciones</h3>
        <div class="table-responsive card p-2">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr id="cabecera-tabla-matriculas"></tr>
                </thead>
                <tbody id="cuerpo-tabla-matriculas"></tbody>
            </table>
        </div>
    </section>
</main>

<!-- Modal de confirmación de baja -->
<div class="modal fade" id="modal-cancelar-matricula" tabindex="-1"
    aria-labelledby="titulo-modal-cancelar" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="titulo-modal-cancelar" class="modal-title h5">Cancelar matrícula</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p id="texto-modal-cancelar" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn border-secondary" data-bs-dismiss="modal">Mantener</button>
                <button type="button" id="confirmar-cancelar-matricula" class="btn border-danger">Dar de baja</button>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer', { scripts: ['matriculas'] }) %>
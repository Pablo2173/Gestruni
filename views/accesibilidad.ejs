<%- include('partials/header', { title: 'Accesibilidad', actual: 'accesibilidad' }) %>

<main class="container py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/index.html">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Accesibilidad</li>
        </ol>
    </nav>

    <h2 class="mb-3"><i class="bi bi-universal-access text-success me-2"></i>Opciones de Accesibilidad</h2>
    <p class="text-muted mb-4">
        Personaliza la apariencia visual de Gestruni. Tus preferencias se guardarán automáticamente en este navegador y se aplicarán a toda la plataforma.
    </p>

    <div id="alerta-accesibilidad" class="d-none" role="status" aria-live="polite"></div>

    <div class="row g-4">
        <section class="col-lg-7" aria-labelledby="titulo-config-accesibilidad">
            <div class="card h-100">
                <div class="card-body">
                    <h3 id="titulo-config-accesibilidad" class="h4 mb-4">Preferencias de visualización</h3>

                    <form id="form-accesibilidad" class="row g-4">
                        <fieldset class="col-12">
                            <legend class="form-label fs-6 mb-2">Esquema de color y contraste</legend>
                            <div class="d-flex flex-column gap-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="tema" id="tema-light" value="light" checked>
                                    <label class="form-check-label" for="tema-light">
                                        <strong>Tema Claro (por defecto)</strong> — Paleta institucional estándar.
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="tema" id="tema-dark" value="dark">
                                    <label class="form-check-label" for="tema-dark">
                                        <strong>Modo Oscuro</strong> — Reduce el brillo de pantalla en entornos con poca luz.
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="tema" id="tema-daltonismo" value="daltonismo">
                                    <label class="form-check-label" for="tema-daltonismo">
                                        <strong>Alto Contraste / Daltonismo</strong> — Combinación cromática adaptada sin ambigüedad rojo/verde.
                                    </label>
                                </div>
                            </div>
                        </fieldset>

                        <div class="col-12">
                            <label for="select-escala-fuente" class="form-label">Tamaño general del texto e interfaz</label>
                            <select id="select-escala-fuente" class="form-select">
                                <option value="1">Normal (1em — Estándar)</option>
                                <option value="1.125">Grande (1.125em — +12.5%)</option>
                                <option value="1.25">Muy grande (1.25em — +25%)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="check-lectura-comoda">
                                <label class="form-check-label" for="check-lectura-comoda">
                                    <strong>Activar espaciado de lectura ampliado</strong> (mayor interlineado y separación entre palabras)
                                </label>
                            </div>
                        </div>

                        <div class="col-12 d-flex flex-wrap gap-2 pt-2">
                            <button type="submit" class="btn border-success fw-semibold">Guardar preferencias</button>
                            <button type="button" id="btn-restablecer-accesibilidad" class="btn border-secondary">
                                Restablecer valores por defecto
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </section>

        <section class="col-lg-5" aria-labelledby="titulo-vista-previa">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h3 id="titulo-vista-previa" class="h4 mb-3">Vista previa en directo</h3>
                    <p class="mb-3">
                        Este bloque refleja en tiempo real cómo se verán los textos, enlaces y botones en el resto de la aplicación con tus ajustes actuales.
                    </p>

                    <div class="p-3 rounded border mb-4">
                        <h4 class="h5 mb-2">Ejemplo de tarjeta de curso</h4>
                        <p class="text-muted mb-3">
                            Desarrollo de Aplicaciones Web con Node.js, Express y MariaDB. Horario de tarde.
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn border-success btn-sm">Botón principal</button>
                            <button type="button" class="btn border-danger btn-sm">Botón de acción</button>
                        </div>
                    </div>

                    <div class="mt-auto pt-3 border-top">
                        <h4 class="h6 text-uppercase text-muted mb-2">Navegación por teclado</h4>
                        <ul class="small mb-0">
                            <li>Usa <kbd>Tab</kbd> y <kbd>Shift + Tab</kbd> para desplazarte entre controles con foco resaltado.</li>
                            <li>Pulsa <kbd>Enter</kbd> o <kbd>Espacio</kbd> para activar botones, enlaces o desplegables.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>
    </div>
</main>

<%- include('partials/footer', { scripts: ['accesibilidad'] }) %>